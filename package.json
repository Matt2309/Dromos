{
	"name": "dromos",
	"version": "0.1.4",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"biome:format": "biome format",
		"biome:format:fix": "biome format --write",
		"biome:lint": "biome check",
		"biome:lint:fix": "biome check --write",
		"docker:build": "docker compose -f docker/compose.prod.yml --env-file .env.production.local build",
		"docker:dev": "docker compose -f docker/compose.dev.yml --env-file .env.local up --build --remove-orphans",
		"docker:inspect": "docker inspect dromos:prod --format='{{.Os}}/{{.Architecture}}'",
		"docker:prod": "docker run --env-file .env.production.local -p 3000:3000 dromos:prod",
		"db:format": "npx dotenv-cli -e .env.local -- npx prisma format",
		"db:generate": "npx dotenv-cli -e .env.local -- npx prisma generate",
		"db:migrate:deploy": "npx dotenv-cli -e .env.local -- npx prisma migrate deploy",
		"db:migrate:dev": "npx dotenv-cli -e .env.local -- npx prisma migrate dev",
		"db:push": "npx dotenv-cli -e .env.local -- npx prisma db push",
		"db:reset": "npx dotenv-cli -e .env.local -- npx prisma migrate reset",
		"db:studio": "npx dotenv-cli -e .env.local -- npx prisma studio",
		"db:encrypt-tokens": "npx dotenv-cli -e .env.local -- npx tsx scripts/encrypt-account-tokens.ts",
		"db:disable-2fa": "npx dotenv-cli -e .env.local -- npx tsx scripts/disable-two-factor.ts",
		"stg-db:push": "npx dotenv-cli -e .env.stg.local -- npx prisma db push",
		"stg-db:reset": "npx dotenv-cli -e .env.stg.local -- npx prisma migrate reset",
		"stg-db:studio": "npx dotenv-cli -e .env.stg.local -- npx prisma studio",
		"stg-db:encrypt-tokens": "npx dotenv-cli -e .env.stg.local -- npx tsx scripts/encrypt-account-tokens.ts",
		"stg-db:disable-2fa": "npx dotenv-cli -e .env.stg.local -- npx tsx scripts/disable-two-factor.ts",
		"prod-db:push": "npx dotenv-cli -e .env.production.local -- npx prisma db push",
		"prod-db:reset": "npx dotenv-cli -e .env.production.local -- npx prisma migrate reset",
		"prod-db:studio": "npx dotenv-cli -e .env.production.local -- npx prisma studio",
		"prod-db:encrypt-tokens": "npx dotenv-cli -e .env.production.local -- npx tsx scripts/encrypt-account-tokens.ts",
		"prod-db:disable-2fa": "npx dotenv-cli -e .env.production.local -- npx tsx scripts/disable-two-factor.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@better-fetch/fetch": "^1.1.21",
		"@jojojoseph/toon-json-converter": "^2.0.3",
		"@next/third-parties": "^16.4.3",
		"@orpc/client": "^1.16.1",
		"@orpc/server": "^1.16.1",
		"@orpc/tanstack-query": "^1.16.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-query-devtools": "^5.91.3",
		"@tanstack/react-table": "^8.21.3",
		"better-auth": "^1.6.33",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.3.1",
		"framer-motion": "^12.38.0",
		"lucide-react": "^1.7.0",
		"next": "16.4.3",
		"next-themes": "^0.4.6",
		"path-to-regexp": "^8.4.2",
		"pg": "^8.20.0",
		"react": "19.2.9",
		"react-dom": "19.2.9",
		"react-markdown": "^10.1.0",
		"react-qr-code": "^2.2.0",
		"shadcn": "^4.22.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.18.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"prisma": "^7.10.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^5"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/engines",
			"prisma",
			"sharp",
			"esbuild",
			"msw"
		]
	}
}

ARG NODE_VERSION=22.23.4

# ============================================================================
# Base Stage: Common setup for all subsequent stages
# ============================================================================
FROM node:${NODE_VERSION}-alpine AS base

# Install essential dependencies for Next.js and Prisma
# - bash: useful for scripts and debugging
# - openssl3: required by Prisma for secure (SSL/TLS) database connections (use v3 for Alpine 22)
# - libc6-compat: needed by binary dependencies on musl/Alpine systems

# `apk upgrade` pulls in Alpine security patches published after the base
# image was built (build with `--pull --no-cache` so this layer is not reused).
RUN apk upgrade --no-cache && \
    apk add --no-cache bash openssl3 libc6-compat

# Enable Corepack globally (once per base, not redundantly in each stage) and
# pin pnpm to the version in package.json instead of whatever is "latest".
RUN npm install -g corepack@latest && \
    corepack enable && \
    corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# ============================================================================
# Dependencies Stage: Install dependencies with layer caching
# ============================================================================
FROM base AS deps

# Copy only package manager files first to maximize Docker layer cache
# Separating this from source code means dependency changes don't invalidate the cache
COPY package.json pnpm-lock.yaml* .npmrc* ./

# Install dependencies with frozen lockfile for reproducible builds
# --prod would be used here if we weren't using standalone output
RUN pnpm install --frozen-lockfile

# ============================================================================
# Builder Stage: Build the Next.js application
# ============================================================================
FROM base AS builder

# Set build-time environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code (now that dependencies are cached, this is separate)
COPY . .

# Copy Prisma schema and pre-generated client (if they exist)
# Prisma client should ideally be generated locally before Docker build to avoid
# Node version compatibility issues. However, we make it optional here.
# If Prisma is used but client doesn't exist, generation will be attempted.
# IMPORTANT: For best results, run this locally before building:
#   npx prisma generate
RUN if [ -d prisma ] && [ ! -d lib/generated/prisma ]; then \
      echo "⚠️  Prisma client not found. Attempting to generate..."; \
      npx prisma generate || echo "⚠️  Prisma generation failed. If you use Prisma, generate locally with: npx prisma generate"; \
    fi

# Build Next.js application
# With output: 'standalone' in next.config.ts, this creates an optimized .next/standalone
# Provide dummy environment variables if they don't exist (needed for build-time validation)
RUN STRAVA_CLIENT_ID=${STRAVA_CLIENT_ID:-dummy_build_value} \
    STRAVA_CLIENT_SECRET=${STRAVA_CLIENT_SECRET:-dummy_build_value} \
    STRAVA_REDIRECT_URI=${STRAVA_REDIRECT_URI:-http://localhost:3000/strava/auth/callback} \
    DATABASE_URL=${DATABASE_URL:-postgresql://dummy:dummy@localhost:5432/dummy} \
    BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-dummy_build_secret} \
    BETTER_AUTH_URL=${BETTER_AUTH_URL:-http://localhost:3000} \
    GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-dummy_google_id} \
    GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-dummy_google_secret} \
    pnpm build

# ============================================================================
# Runner Stage: Minimal production image
# ============================================================================
FROM node:${NODE_VERSION}-alpine AS runner

# Set runtime environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Docker sets HOSTNAME to the container id, which standalone server.js would
# bind to; listen on all interfaces so localhost (healthcheck) works too.
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Alpine security patches, and drop the package managers: the app runs
# `node server.js` only, so npm/npx/corepack/yarn are attack surface at best.
RUN apk upgrade --no-cache && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

# Security: Create a non-root user to run the application
# Prevents privilege escalation attacks
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

WORKDIR /app

# Copy only the minimal necessary files from builder stage
# .next/standalone contains the complete app with dependencies tree optimized
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# The project has no public/ directory. If one is added, copy it here:
#   COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# Switch to non-root user before running the app
USER nextjs

EXPOSE 3000

# Health check: allows orchestrators to detect when the app is ready.
# /login (not /): "/" answers a 307 redirect for signed-out visitors, and
# http.get does not follow redirects.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/login', {timeout: 2500}, (r) => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1)).on('timeout', () => process.exit(1))"

# Start the application
# Use node server.js directly (from standalone) instead of npm start
# This reduces memory overhead and improves startup time
CMD ["node", "server.js"]
DATABASE_URL=postgresql://user:password@localhost:5432/dromos

BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
# Numeric id of the Strava push subscription (the "id" returned by
#   curl -G https://www.strava.com/api/v3/push_subscriptions \
#     -d client_id=<id> -d client_secret=<secret>
# ). When set, webhook events carrying another subscription_id are ignored.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CRON_SECRET=your-cron-secret-min-32-chars

# 32 bytes, base64 (or 64 hex chars) — used to encrypt Account OAuth tokens
# (accessToken/refreshToken/idToken) at rest. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Transactional email (Resend). Leave RESEND_API_KEY empty in local dev:
# emails are then only logged to stdout instead of being sent.
RESEND_API_KEY=
# Verified sender. Use "Dromos <onboarding@resend.dev>" before your own
# domain is verified in Resend — that shared sender can only deliver to the
# address that owns the Resend account.
EMAIL_FROM=Dromos <no-reply@dromos.studio>
